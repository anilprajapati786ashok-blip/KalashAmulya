<section class="roopak-faq-section" id="faq">
    <div class="content-container">
        <div class="section-title-wrap text-center">
            <span class="roopak-eyebrow">TRANSPARENT REASSURANCE</span>
            <h2 class="roopak-section-title">Frequently Asked <em>Questions (FAQ)</em></h2>
