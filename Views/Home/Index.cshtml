<!-- =========================================================================
     4. BESTSELLER DRY FRUITS GRID: QUESTION HEADING (WITH CYLINDRICAL JARS)
     ========================================================================= -->
<section class="roopak-bestsellers-section" id="bestsellers">
    <div class="content-container">
        <div class="section-title-wrap">
            <span class="roopak-eyebrow">CUSTOMER FAVOURITES</span>
            <h2 class="roopak-section-title">Which Bestseller Dry Fruits Do Customers <em>Love the Most?</em></h2>
            <p class="section-subtext">Each batch is triple-sorted for uniform size, moisture-verified below 5%, and vacuum-sealed in airtight cylindrical jars for extraordinary crunch.</p>
        </div>

                <div class="bestsellers-grid">
            @foreach (var prod in bestsellersList)
            {
                <div class="roopak-product-card" data-product-id="@prod.Id" data-category="@prod.Category">
                    @if (prod.Tag?.ToUpper().Contains("POPULAR") == true || prod.Tag?.ToUpper().Contains("BESTSELLER") == true || prod.Tag?.ToUpper().Contains("ROYAL") == true) { <div class="card-ribbon-popular">Most Popular</div> }
                    <div class="product-thumb-box" onclick="window.kalashOpenModal && window.kalashOpenModal(@prod.Id)">
                        <div class="amulya-jar-showcase">
                            <div class="amulya-jar-cap"></div>
                            <div class="amulya-jar-neck"></div>
                            <div class="amulya-jar-body">
                                <img class="amulya-jar-fill" src="@prod.ImageUrl" alt="@prod.Name" loading="lazy" onerror="this.src='/images/cashew.png'" />
                                <div class="amulya-jar-glare"></div>
                                <div class="amulya-jar-sticker">
                                    <span class="st-brand">AMULYA</span>
                                    <span class="st-name">@prod.Name.ToUpperInvariant()</span>
                                </div>
                            </div>
                            <div class="amulya-jar-shadow"></div>
                        </div>
                    </div>
                    <div class="product-details-box">
                        <h3 class="product-name" onclick="window.kalashOpenModal && window.kalashOpenModal(@prod.Id)">@prod.Name</h3>
                        <div class="product-price-tag">&#8377;@prod.Price.ToString("0.00")</div>
                        @if (prod.Stock > 0)
                        {
                            <button type="button" class="btn-outline-add" onclick="window.kalashAddToCart(@prod.Id)">
                                ADD TO CART
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-outline-add btn-out-of-stock" disabled>
                                OUT OF STOCK
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- =========================================================================
     5. SPLIT PROMO GRID A: HIMALAYAN PINK SALT + 3 PRODUCT CARDS
     ========================================================================= -->
<section class="split-promo-section" id="salts">
    <div class="content-container">
        <div class="split-promo-grid layout-left-featured">
            <!-- Left: Large Lifestyle Feature Card -->
            <div class="promo-feature-banner banner-pink-salt">
                <div class="feature-banner-content">
                    <span class="feature-pill-badge">84+ NATURAL TRACE MINERALS</span>
                    <h3 class="feature-title">Pure Himalayan Pink Salt &amp; Mineral Seasonings</h3>
                    <p class="feature-text">
                        Mined ethically from untouched subterranean crystal caves. Completely unbleached, free from synthetic micro-plastic anti-caking agents, and balancing electrolytes naturally.
                    </p>
                    <ul class="feature-checklist">
                        <li><span>&#10003;</span> 100% Unrefined &amp; Non-Iodized Raw Form</li>
                        <li><span>&#10003;</span> Rich in Bio-Available Potassium &amp; Calcium</li>
                        <li><span>&#10003;</span> Stone-Crushed in Airtight Food-Grade Glass Jars</li>
                    </ul>
                    <a href="#shop" class="feature-action-btn">
                        <span>Shop Seasonings Collection</span>
                        <span class="btn-arrow">&rarr;</span>
                    </a>
                </div>
            </div>

                        <!-- Right: 3 Product Cards -->
            <div class="promo-cards-column">
                @foreach (var prod in new[] { p14, p16, p17 })
                {
                    <div class="mini-product-card" data-product-id="@prod.Id">
                        <div class="mini-thumb">
                            <div class="amulya-jar-showcase mini-jar">
                                <div class="amulya-jar-cap"></div>
                                <div class="amulya-jar-neck"></div>
                                <div class="amulya-jar-body">
                                    <img class="amulya-jar-fill" src="@prod.ImageUrl" alt="@prod.Name" loading="lazy" />
                                    <div class="amulya-jar-glare"></div>
                                    <div class="amulya-jar-sticker">
                                        <span class="st-brand">AMULYA</span>
                                        <span class="st-name">@prod.Name.ToUpperInvariant()</span>
                                        <span class="st-pure">100% PURE &bull; MINERAL</span>
                                    </div>
                                </div>
                                <div class="amulya-jar-shadow"></div>
                            </div>
                        </div>
                        <div class="mini-info">
                            <span class="mini-cat">@prod.Category &bull; @prod.Weight</span>
                            <h4 class="mini-title">@prod.Name</h4>
                            <p class="mini-desc">@prod.Description</p>
                            <div class="mini-price-row">
                                <div class="mini-prices">
                                    <strong>&#8377;@prod.Price</strong>
                                    <small>&#8377;@(prod.Mrp > 0 ? prod.Mrp : Math.Round(prod.Price * 1.25m))</small>
                                    @if (prod.Stock <= 20 && prod.Stock > 0)
                                    {
                                        <span class="stock-indicator-badge stock-badge-low" style="font-size: 8px;">Only @prod.Stock left</span>
                                    }
                                </div>
                                @if (prod.Stock > 0)
                                {
                                    <button type="button" class="mini-add-btn" onclick="window.kalashAddToCart(@prod.Id)">+ ADD</button>
                                }
                                else
                                {
                                    <button type="button" class="mini-add-btn" disabled style="opacity: 0.5;">OUT</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

