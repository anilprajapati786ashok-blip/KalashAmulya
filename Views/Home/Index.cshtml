@model IEnumerable<KalashAmulya.Models.AdminProductItem>
@{
    ViewData["Title"] = "Cherubic Amulya - Pure Goodness Since Heritage";
    Layout = "_Layout";

    var allProducts = Model?.ToList() ?? new List<KalashAmulya.Models.AdminProductItem>();
    
    KalashAmulya.Models.AdminProductItem GetP(int id, string fallbackName, decimal fallbackPrice, string fallbackImg, string fallbackCat, string fallbackWeight, string fallbackTag, string fallbackDesc, int fallbackStock = 50)
    {
        var found = allProducts.FirstOrDefault(p => p.Id == id);
        if (found != null) return found;
        return new KalashAmulya.Models.AdminProductItem
        {
            Id = id,
            Name = fallbackName,
            Price = fallbackPrice,
            Mrp = Math.Round(fallbackPrice * 1.25m),
            ImageUrl = fallbackImg,
            Category = fallbackCat,
            Weight = fallbackWeight,
            Tag = fallbackTag,
            Description = fallbackDesc,
            Stock = fallbackStock,
            IsActive = true
        };
    }

    // DRY FRUITS (5 items)
    var p1 = GetP(1, "Royal Jumbo Cashews (Kaju W240)", 420m, "/images/cashew_bowl.png", "Dry Fruits", "250g Jar", "BESTSELLER", "Hand-graded jumbo whole white cashews. Naturally creamy & rich in healthy fats.", 85);
    var p2 = GetP(2, "California Crisp Almonds (Badam)", 380m, "/images/almond_bowl.png", "Dry Fruits", "250g Jar", "HARVEST SELECT", "Crunchy, golden-brown California badam rich in Vitamin E, magnesium and antioxidants.", 64);
    var p3 = GetP(3, "Salted Roasted Pistachios (Pista)", 520m, "/images/pistachio_bowl.png", "Dry Fruits", "250g Jar", "POPULAR", "Naturally cracked, gently roasted with Himalayan sea salt. Unopened shell-free guarantee.", 42);
    var p4 = GetP(4, "Royal Iranian Mamra Badam", 750m, "/images/almond_bowl.png", "Dry Fruits", "250g Jar", "ROYAL HARVEST", "Original high-oil Iranian Mamra giri. Unrivalled natural sweetness and brain nourishment.", 28);
    var p5 = GetP(5, "Jumbo Foxnut Phool Makhana", 290m, "/images/makhana_bowl.png", "Dry Fruits", "200g Jar", "SUPER-CRUNCH", "Handpicked jumbo 6-suta fox nuts. Air-popped to airy crispness with zero bitter seeds.", 14);

    // SEEDS (4 items)
    var p6 = GetP(6, "Raw Sunflower Seeds", 190m, "/images/cashew_bowl.png", "Seeds", "250g Jar", "VITAMIN E", "Cleaned kernel kernels supporting cellular repair, cardiac health, and radiant skin.", 82);
    var p7 = GetP(7, "Roasted Watermelon Seeds", 210m, "/images/pistachio_bowl.png", "Seeds", "200g Jar", "ZINC & PROTEIN", "Crunchy hulled tarbooj seeds loaded with magnesium and plant protein for quick snacking.", 65);
    var p8 = GetP(8, "Golden Flax Seeds (Alsi)", 150m, "/images/almond_bowl.png", "Seeds", "250g Jar", "OMEGA-3 HERO", "Highest natural vegetarian source of ALA Omega-3 fatty acids for lipid management.", 90);
    var p9 = GetP(9, "Organic Chia Seeds", 220m, "/images/walnut_bowl.png", "Seeds", "250g Jar", "SOLUBLE FIBER", "Pristine raw black chia seeds that form a soothing gut-protective gel when soaked in water.", 75);

    // SALTS & SEASONINGS (4 items)
    var p10 = GetP(10, "Himalayan Pink Rock Salt Crystals", 140m, "/images/pistachio_pile.png", "Salts & Seasonings", "500g Jar", "MINERAL RICH", "Unrefined pink subterranean crystals rich in natural trace electrolytes.", 120);
    var p11 = GetP(11, "Kala Namak (Black Salt Powder)", 110m, "/images/cashew_pile.png", "Salts & Seasonings", "500g Jar", "AYURVEDIC", "Authentic kiln-fired digestive rock salt with traditional pungent aroma.", 95);
    var p12 = GetP(12, "Organic Oregano & Herb Blend", 160m, "/images/walnut_pile.png", "Salts & Seasonings", "100g Jar", "HANDCRAFTED", "Sun-dried aromatic Mediterranean oregano leaves, crushed pepper & sea salt.", 60);
    var p13 = GetP(13, "Royal Heritage Spices & Shahi Garam Masala", 210m, "/images/cashew_pile.png", "Salts & Seasonings", "100g Jar", "AROMATIC", "Stone-ground whole spice blend featuring green cardamom, clove, cinnamon & mace.", 55);

    // PRESERVES & SWEETS (5 items)
    var p14 = GetP(14, "Pure Desi Shakkariya Jaggery (Gur)", 195m, "/images/walnut_bowl.png", "Preserves & Sweets", "500g Jar", "PURE GUR", "Additive-free raw cane sugar blocks clarifying gut toxins and boosting iron.", 48);
    var p15 = GetP(15, "Satvik Pure Cow Ghee Besan Ladoo", 320m, "/images/almond_pile.png", "Preserves & Sweets", "400g Jar", "DESI GHEE", "Traditional slow-roasted gram flour sweets crafted with A2 bilona cow ghee and rock sugar.", 30);
    var p16 = GetP(16, "Organic Amla Murabba in Mishri", 260m, "/images/makhana_bowl.png", "Preserves & Sweets", "500g Glass Jar", "HERITAGE", "Whole Himalayan wild amla steeped slowly in unrefined raw rock sugar syrup.", 35);
    var p17 = GetP(17, "Chatpata Amla Candy", 180m, "/images/cashew_bowl.png", "Preserves & Sweets", "300g Jar", "DIGESTIVE", "Sweet and sour Vitamin-C bites spiced with digestive rock salt and cumin.", 70);
    var p18 = GetP(18, "Traditional Ramkela Mango Pickles", 240m, "/images/walnut_pile.png", "Preserves & Sweets", "500g Jar", "COLD-PRESSED", "Sun-cured raw Ramkela mango steeped in cold-pressed mustard oil with fenugreek & fennel.", 40);

    // GRAINS & PULSES (3 items)
    var p19 = GetP(19, "Certified Unpolished Pulses (20 Varieties)", 185m, "/images/pistachio_bowl.png", "Grains & Pulses", "1kg Jar", "100% UNPOLISHED", "Cooperative harvested unpolished pulses. Zero chemical wash, maximum protein & earthy broth.", 110);
    var p20 = GetP(20, "Organic White Quinoa", 280m, "/images/makhana_pile.png", "Grains & Pulses", "500g Jar", "COMPLETE PROTEIN", "Pre-washed, saponin-free ancient super grain containing all 9 essential amino acids.", 45);
    var p21 = GetP(21, "Heritage Roasted Daliya", 120m, "/images/cashew_solid.jpg", "Grains & Pulses", "500g Jar", "HIGH FIBER", "Stone-milled broken whole wheat gently pre-roasted for quick morning porridge & khichdi.", 75);

    var bestsellersList = new[] { p1, p2, p3, p4, p5 };
    var staplesList = new[] { p19, p20, p21 };
    var seedsList = new[] { p6, p7, p8, p9 };
}

