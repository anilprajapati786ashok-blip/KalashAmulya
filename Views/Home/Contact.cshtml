@{
    ViewData["Title"] = "Contact Us & Kanpur Headquarters - Cherubic Amulya";
    Layout = "_Layout";
}

<div class="contact-page-wrapper">
    <!-- Header -->
    <section class="contact-hero-banner">
        <div class="content-container text-center">
            <span class="roopak-eyebrow">WE ARE AT YOUR SERVICE</span>
            <h1 class="roopak-section-title">Get in Touch with <em>Cherubic Amulya</em></h1>
            <p class="section-subtext">
                Have questions regarding our unpolished pulses, dry fruit harvest batches, bulk festive gifting, or Kanpur local delivery? Reach out to our customer care desk.
            </p>
        </div>
    </section>

    <section class="contact-main-section">
        <div class="content-container">
            <div class="contact-columns-grid">
                <!-- Left: Headquarters Details & Google Maps Placeholder -->
                <div class="contact-info-panel">
                    <div class="info-card-block">
                        <span class="info-badge">KANPUR REGISTERED FACILITY</span>
                        <h3>Manufacturing &amp; Quality Hub</h3>
                        <div class="contact-detail-row">
                            <span class="detail-icon">&#128205;</span>
                            <div>
                                <strong>Physical Address:</strong>
                                <p>173-B, Dada Nagar Industrial Area, Kanpur-208022, Uttar Pradesh, India</p>
                            </div>
                        </div>

                        <div class="contact-detail-row">
                            <span class="detail-icon">&#9742;</span>
                            <div>
                                <strong>Customer Support Phone:</strong>
                                <p><a href="tel:+915122295000" class="contact-link">+91 512 2295000</a> / <a href="tel:+919876543210" class="contact-link">+91 98765 43210</a></p>
                            </div>
                        </div>

                        <div class="contact-detail-row">
                            <span class="detail-icon">&#9993;</span>
                            <div>
                                <strong>Email Inquiries:</strong>
                                <p><a href="mailto:care@kalashamulya.com" class="contact-link">care@kalashamulya.com</a></p>
                            </div>
                        </div>

                        <div class="contact-detail-row">
                            <span class="detail-icon">&#128340;</span>
                            <div>
                                <strong>Operating Hours:</strong>
                                <p>Monday &ndash; Saturday: 9:00 AM &ndash; 7:00 PM IST (Closed on Sundays)</p>
                            </div>
                        </div>
                    </div>

                    <!-- Google Maps Embed Placeholder -->
                    <div class="maps-placeholder-card">
                        <div class="maps-visual-mock">
                            <div class="maps-pin-marker">
                                <span class="pin-symbol">&#128205;</span>
                                <div class="pin-pulse"></div>
                            </div>
                            <div class="maps-caption">
                                <strong>173-B, Dada Nagar, Kanpur</strong>
                                <small>Latitude: 26.4385° N, Longitude: 80.3015° E</small>
                            </div>
                        </div>
                        <div class="maps-actions-row">
                            <a href="https://maps.google.com/?q=Dada+Nagar+Industrial+Area+Kanpur" target="_blank" rel="noopener noreferrer" class="btn-maps-external">
                                <span>Open in Google Maps</span>
                                <span class="btn-arrow">&nearr;</span>
                            </a>
                            <span class="maps-verified-text">&#10003; Verified Manufacturing Facility</span>
                        </div>
                    </div>
                </div>

                <!-- Right: Interactive Contact Form -->
                <div class="contact-form-panel">
                    <div class="contact-form-card">
                        <h2 class="form-card-title">Send Our Desk a Message</h2>
                        <p class="form-card-subtitle">Fill in the details below and an Amulya customer executive will contact you shortly.</p>

                        @if (ViewBag.Submitted == true)
                        {
                            <div class="contact-success-banner" role="alert">
                                <div class="success-icon">&#10003;</div>
                                <div>
                                    <h4>Message Dispatched Successfully!</h4>
                                    <p>@ViewBag.SuccessMessage</p>
                                </div>
                            </div>
                        }

                        <form method="post" action="/Home/Contact" class="contact-inquiry-form">
                            <div class="form-row-two">
                                <div class="form-group">
                                    <label for="contactName">Full Name *</label>
                                    <input type="text" id="contactName" name="name" required placeholder="e.g. Alok Verma" class="auth-input" />
                                </div>
                                <div class="form-group">
                                    <label for="contactEmail">Email Address *</label>
                                    <input type="email" id="contactEmail" name="email" required placeholder="e.g. alok@example.com" class="auth-input" />
                                </div>
                            </div>

                            <div class="form-row-two">
                                <div class="form-group">
                                    <label for="contactPhone">Mobile Number *</label>
                                    <input type="tel" id="contactPhone" name="phone" required pattern="[6-9][0-9]{9}" maxlength="10" placeholder="10-digit mobile number" class="auth-input" />
                                </div>
                                <div class="form-group">
                                    <label for="contactSubject">Subject of Inquiry</label>
                                    <select id="contactSubject" name="subject" class="auth-input">
                                        <option value="General Question">General Product Question</option>
                                        <option value="Kanpur Delivery">Kanpur Local Same-Day Delivery</option>
                                        <option value="Bulk Order">Bulk &amp; Corporate Gifting</option>
                                        <option value="Purity / FSSAI">Purity Standards &amp; Lab Reports</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="contactMessage">Your Message *</label>
                                <textarea id="contactMessage" name="message" rows="4" required placeholder="Please describe your requirements, questions or feedback in detail..." class="auth-input"></textarea>
                            </div>

                            <button type="submit" class="auth-submit-btn">
                                <span>Send Message to Kanpur Desk</span>
                                <span class="btn-arrow">&rarr;</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
