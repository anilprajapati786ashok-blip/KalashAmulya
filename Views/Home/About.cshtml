@{
    ViewData["Title"] = "Our Heritage & Philosophy - Kalash Amulya";
    Layout = "_Layout";
}

<div class="heritage-page-wrapper">
    <!-- Hero Banner -->
    <section class="heritage-hero-banner">
        <div class="content-container text-center">
            <span class="roopak-eyebrow">ESTABLISHED 1958 &bull; KANPUR, INDIA</span>
            <h1 class="roopak-section-title">The Kalash Heritage of <em>Unadulterated Purity</em></h1>
            <p class="section-subtext">
                For over six decades, the Kalash Group has stood as a bastion of ethical sourcing, bringing whole sun-ripened dry fruits, stone-ground mineral seasonings, and certified 100% unpolished pulses directly to conscious Indian homes.
            </p>
        </div>
    </section>

    <!-- Facility & Provenance Section -->
    <section class="heritage-provenance-section">
        <div class="content-container">
            <div class="provenance-grid">
                <div class="provenance-card">
                    <span class="prov-tag">OUR ORIGIN</span>
                    <h3>Rooted in Kanpur Since 1958</h3>
                    <p>
                        What started as a modest agro-commodity trading enterprise in the historic heart of Kanpur has grown into an internationally benchmarked food processing powerhouse. Guided by traditional Ayurvedic wisdom and reverence for nature's harvest, we refuse chemical polishes, artificial sulphur bleaching, or synthetic moisture preservatives.
                    </p>
                    <div class="facility-address-pill">
                        <span class="pill-pin">&#128205;</span>
                        <span><strong>Central Facility:</strong> 173-B, Dada Nagar Industrial Area, Kanpur-208022, Uttar Pradesh</span>
                    </div>
                </div>

                <div class="provenance-card fssai-focus-card" id="fssai">
                    <span class="prov-tag fssai-tag">CENTRAL CERTIFICATION</span>
                    <h3>FSSAI Standard &amp; Lab Audits</h3>
                    <p>
                        Kalash Amulya operates under Central FSSAI License <strong>12721055000341</strong>. Every incoming batch from Kashmir, Gujarat, and the Himalayan valleys undergoes an exhaustive 5-stage mechanical sorting, optical defect elimination, and moisture validation below 5% to prevent natural oil rancidity.
                    </p>
                    <div class="compliance-badges-row">
                        <span class="cert-badge">&#10003; ISO 22000 Certified</span>
                        <span class="cert-badge">&#10003; GMP Food Grade</span>
                        <span class="cert-badge">&#10003; 100% Unpolished</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- The 100% Unpolished Revolution -->
    <section class="unpolished-philosophy-section" id="unpolished">
        <div class="content-container">
            <div class="section-title-wrap text-center">
                <span class="roopak-eyebrow">A SACRED COMMITMENT</span>
                <h2 class="roopak-section-title">Why We Insist on <em>100% Unpolished Pulses</em></h2>
                <p class="section-subtext">Supermarket pulses are frequently doused in water, talc powder, or oil polishes to gleam on shelves. Here is why Kalash Amulya keeps every pulse completely unpolished.</p>
            </div>

            <div class="unpolished-pillars-grid">
                <div class="pillar-card">
                    <div class="pillar-icon">&#127806;</div>
                    <h4>Aleurone Layer Intact</h4>
                    <p>Commercial polishing strips away the delicate aleurone seed coat which holds up to 60% of the dal's vital vegetable proteins and water-soluble vitamins.</p>
                </div>
                <div class="pillar-card">
                    <div class="pillar-icon">&#129656;</div>
                    <h4>Natural Dietary Fiber</h4>
                    <p>Retaining natural fiber ensures slow carbohydrate breakdown, preventing rapid post-meal glucose spikes and supporting healthy gut microbiota.</p>
                </div>
                <div class="pillar-card">
                    <div class="pillar-icon">&#9878;</div>
                    <h4>Zero Synthetic Dyes</h4>
                    <p>No artificial yellow dyes, leather buffing, or paraffin coatings. You receive rustic, earthy lentils that cook to a creamy natural broth.</p>
                </div>
                <div class="pillar-card">
                    <div class="pillar-icon">&#128737;</div>
                    <h4>Food Grade Jar Packaging</h4>
                    <p>Every dry fruit, seed, and staple is packed in airtight cylindrical jars with moisture-barrier seals to ensure uncompromised crunch and aroma.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Heritage Timeline -->
    <section class="heritage-timeline-section">
        <div class="content-container">
            <div class="section-title-wrap text-center">
                <span class="roopak-eyebrow">OUR JOURNEY</span>
                <h2 class="roopak-section-title">Six Decades of <em>Trust &amp; Nutrition</em></h2>
            </div>

            <div class="timeline-container">
                <div class="timeline-step">
                    <div class="timeline-year">1958</div>
                    <div class="timeline-content">
                        <h4>Founding of Kalash Group</h4>
                        <p>Established as an honest trading house in Kanpur, dedicated to procuring agricultural crops directly from grower cooperatives.</p>
                    </div>
                </div>
                <div class="timeline-step">
                    <div class="timeline-year">1985</div>
                    <div class="timeline-content">
                        <h4>Dada Nagar Industrial Hub</h4>
                        <p>Inaugurated our flagship temperature-regulated warehousing and state-of-the-art cleaning plant in Kanpur's industrial precinct.</p>
                    </div>
                </div>
                <div class="timeline-step">
                    <div class="timeline-year">2012</div>
                    <div class="timeline-content">
                        <h4>The Unpolished Dal Movement</h4>
                        <p>Pioneered unpolished pulses in North India, refusing chemical polishers and educating families on dietary integrity.</p>
                    </div>
                </div>
                <div class="timeline-step">
                    <div class="timeline-year">2026</div>
                    <div class="timeline-content">
                        <h4>Kalash Amulya Brand &amp; Digital Storefront</h4>
                        <p>Unveiled modern e-commerce delivery across Kanpur and all-India, delivering handpicked harvests sealed in premium cylindrical jars.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bottom CTA -->
    <section class="heritage-cta-section text-center">
        <div class="content-container">
            <h3>Experience the Purity of Handpicked Heritage</h3>
            <p>From royal jumbo cashews to unpolished toor dal, explore our complete harvest.</p>
            <a href="/#shop" class="hero-pill-btn hero-btn-dark" style="margin-top: 16px;">
                <span>Shop the Amulya Collection &rarr;</span>
            </a>
        </div>
    </section>
</div>
